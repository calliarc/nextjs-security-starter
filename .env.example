# Copy to .env.local and fill in. Never commit real values.

# --- Auth.js -----------------------------------------------------------------
# Required. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Set to true when self-hosting behind a reverse proxy (Vercel sets this for you).
# AUTH_TRUST_HOST=true
# Public URL of the app in production, e.g. https://app.example.com
# AUTH_URL=

# Demo credentials user (replace with a real user store).
# Hash a password with: npm run hash-password
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD_HASH=

# Optional GitHub OAuth provider (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- CSRF --------------------------------------------------------------------
# Optional separate signing key (>= 32 chars). Falls back to AUTH_SECRET.
CSRF_SECRET=
# Trust X-Forwarded-Host / X-Forwarded-Proto for the CSRF origin check.
# Only enable behind a proxy that sets these headers.
TRUST_PROXY_HEADERS=false

# --- security.txt ------------------------------------------------------------
# SECURITY_CONTACT=mailto:security@example.com
# SECURITY_POLICY_URL=https://example.com/security-policy
# APP_URL=https://app.example.com
